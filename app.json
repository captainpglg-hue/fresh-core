{
  "expo": {
    "name": "Fresh-Core",
    "slug": "fresh-core",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "freshcore",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.passcore.freshcore"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "io.passcore.freshcore",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Fresh-Core a besoin de la caméra pour photographier les relevés de température et les documents HACCP."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B4332"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1fd7802-bca8-42da-b7c2-07f5ab3bfefc"
      }
    },
    "experiments": {
      "baseUrl": "https://cdn.jsdelivr.net/gh/captainpglg-hue/fresh-core@gh-pages"
    },
    "owner": "freshcore",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a1fd7802-bca8-42da-b7c2-07f5ab3bfefc"
    }
  }
}
